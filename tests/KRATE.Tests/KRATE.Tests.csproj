<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- LibraryImport (source-generated P/Invoke) for the Rust core parity tests. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KRATE.Core\KRATE.Core.csproj" />
  </ItemGroup>

  <!-- The Rust core, for the parity tests. Build it with "cargo build [dash][dash]release" in
       the rust folder. Copied only when present, so the C# build still succeeds on a machine
       without a Rust toolchain; RustParityTests then fails with one clear message, not fifty. -->
  <ItemGroup>
    <None Include="..\..\rust\target\release\krate_core.dll"
          CopyToOutputDirectory="PreserveNewest" Visible="false" Condition="Exists('..\..\rust\target\release\krate_core.dll')" />
  </ItemGroup>

</Project>
