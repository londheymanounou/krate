<UserControl
    x:Class="Krate.Gui.TimezonePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="520" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TimePicker x:Name="Time" ClockIdentifier="24HourClock" SelectedTimeChanged="OnChanged" />
            <TextBlock x:Name="InLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="Source" MinWidth="150" SelectionChanged="OnChanged" />
            <Button x:Name="NowButton" Click="OnNow" />
        </StackPanel>

        <Border CornerRadius="8" BorderThickness="1" Padding="4"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <StackPanel x:Name="Results" Spacing="2" Padding="12" />
        </Border>
    </StackPanel>
</UserControl>
