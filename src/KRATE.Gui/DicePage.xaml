<UserControl
    x:Class="Krate.Gui.DicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="20" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <ComboBox x:Name="DieType" MinWidth="110" Header="Die" />
            <muxc:NumberBox x:Name="Count" Value="1" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" MinWidth="120" Header="How many" />
            <Button x:Name="RollButton" Click="OnRoll" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
        </StackPanel>

        <Grid x:Name="DicePanel" ColumnSpacing="12" RowSpacing="12" HorizontalAlignment="Center" MinHeight="72" />

        <TextBlock x:Name="Total" HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
    </StackPanel>
</UserControl>
