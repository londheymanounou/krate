<UserControl
    x:Class="Krate.Gui.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="520" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <ComboBox x:Name="Category" Header="" HorizontalAlignment="Stretch" SelectionChanged="OnCategory" />

        <Grid ColumnSpacing="12" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <muxc:NumberBox x:Name="Value" Grid.Column="0" Value="1" Header="" ValueChanged="OnChanged" />
            <ComboBox x:Name="From" Grid.Column="1" VerticalAlignment="Bottom" MinWidth="90" SelectionChanged="OnChanged" />
            <ComboBox x:Name="To" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" SelectionChanged="OnChanged" />
        </Grid>

        <TextBlock x:Name="Result" FontSize="24" FontFamily="Consolas" />
    </StackPanel>
</UserControl>
