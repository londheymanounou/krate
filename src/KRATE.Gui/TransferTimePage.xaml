<UserControl
    x:Class="Krate.Gui.TransferTimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="14" MaxWidth="480" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SizeLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
            <muxc:NumberBox x:Name="SizeValue" Grid.Row="0" Grid.Column="1" ValueChanged="OnChanged" />
            <ComboBox x:Name="SizeUnit" Grid.Row="0" Grid.Column="2" MinWidth="92" SelectionChanged="OnChanged" />

            <TextBlock x:Name="RateLabel" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
            <muxc:NumberBox x:Name="RateValue" Grid.Row="1" Grid.Column="1" ValueChanged="OnChanged" />
            <ComboBox x:Name="RateUnit" Grid.Row="1" Grid.Column="2" MinWidth="92" SelectionChanged="OnChanged" />
        </Grid>

        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Result" FontFamily="Consolas" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
