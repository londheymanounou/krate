<UserControl
    x:Class="Krate.Gui.SpellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <muxc:NumberBox x:Name="Number" Header="Number" Value="1234" SpinButtonPlacementMode="Compact" MinWidth="220" ValueChanged="OnChanged" />
            <ComboBox x:Name="LangBox" Header="Language" SelectionChanged="OnChanged" MinWidth="140" VerticalAlignment="Bottom" />
        </StackPanel>

        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Output" FontSize="18" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
