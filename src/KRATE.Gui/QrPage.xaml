<UserControl
    x:Class="Krate.Gui.QrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16" ColumnSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Title" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="12">
            <TextBlock x:Name="Prompt" Opacity="0.7" TextWrapping="Wrap" />
            <TextBox x:Name="Input" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                     TextChanged="OnInput" />
            <Button x:Name="SaveButton" Click="OnSave" />
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="1" Width="260" Height="260" CornerRadius="8" Padding="12"
                Background="White" VerticalAlignment="Top">
            <Image x:Name="QrImage" Stretch="Uniform" />
        </Border>
    </Grid>
</UserControl>
