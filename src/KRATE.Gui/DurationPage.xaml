<UserControl
    x:Class="Krate.Gui.DurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <muxc:NumberBox x:Name="Value" Value="1" SpinButtonPlacementMode="Compact" MinWidth="120" ValueChanged="OnChanged" />
            <ComboBox x:Name="From" MinWidth="130" SelectionChanged="OnChanged" />
            <TextBlock Text="→" FontSize="18" VerticalAlignment="Center" Opacity="0.7" />
            <ComboBox x:Name="To" MinWidth="130" SelectionChanged="OnChanged" />
        </StackPanel>

        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Result" FontSize="18" FontFamily="Consolas" TextWrapping="Wrap" />
        </Border>

        <TextBlock x:Name="AllLabel" Opacity="0.7" />
        <StackPanel x:Name="AllUnits" Spacing="2" />
    </StackPanel>
</UserControl>
