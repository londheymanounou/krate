<UserControl
    x:Class="Krate.Gui.ContrastPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="520" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Orientation="Horizontal" Spacing="16">
            <StackPanel Spacing="6">
                <TextBlock x:Name="FgLabel" />
                <Button Padding="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Rectangle x:Name="FgSwatch" Width="72" Height="48" />
                    <Button.Flyout>
                        <Flyout>
                            <muxc:ColorPicker x:Name="FgPicker" ColorChanged="OnColor" IsAlphaEnabled="False" IsColorChannelTextInputVisible="False" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock x:Name="BgLabel" />
                <Button Padding="0" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Rectangle x:Name="BgSwatch" Width="72" Height="48" />
                    <Button.Flyout>
                        <Flyout>
                            <muxc:ColorPicker x:Name="BgPicker" ColorChanged="OnColor" IsAlphaEnabled="False" IsColorChannelTextInputVisible="False" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </StackPanel>

        <Border x:Name="Preview" CornerRadius="8" Padding="24">
            <StackPanel Spacing="4">
                <TextBlock x:Name="SampleLarge" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="SampleSmall" FontSize="14" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="Result" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
