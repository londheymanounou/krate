<UserControl
    x:Class="Krate.Gui.AspectRatioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="480" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <muxc:NumberBox x:Name="Wid" Header="Width" Value="1920" SpinButtonPlacementMode="Compact" MinWidth="150" ValueChanged="OnChanged" />
            <TextBlock Text="×" FontSize="22" VerticalAlignment="Bottom" Margin="0,0,0,6" />
            <muxc:NumberBox x:Name="Hgt" Header="Height" Value="1080" SpinButtonPlacementMode="Compact" MinWidth="150" ValueChanged="OnChanged" />
        </StackPanel>
        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Result" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
