<UserControl
    x:Class="Krate.Gui.TimestampPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="14" MaxWidth="580" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock x:Name="FromUnixLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <muxc:NumberBox x:Name="Unix" Value="1700000000" SpinButtonPlacementMode="Hidden" MinWidth="220" ValueChanged="OnUnixChanged" />
            <Button x:Name="NowButton" Click="OnNow" />
        </StackPanel>
        <Border CornerRadius="8" Padding="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="FromUnix" FontFamily="Consolas" FontSize="14" IsTextSelectionEnabled="True" />
        </Border>

        <TextBlock x:Name="FromDateLabel" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <CalendarDatePicker x:Name="Date" DateChanged="OnDateChanged" MinWidth="200" />
            <muxc:TimePicker x:Name="Time" ClockIdentifier="24HourClock" SelectedTimeChanged="OnDateChanged" />
        </StackPanel>
        <Border CornerRadius="8" Padding="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="FromDate" FontFamily="Consolas" FontSize="14" IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
