<UserControl
    x:Class="Krate.Gui.ConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Subtitle" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- One-time ffmpeg download prompt -->
        <muxc:InfoBar Grid.Row="1" x:Name="FfmpegBar" IsOpen="False" IsClosable="False" Severity="Warning">
            <muxc:InfoBar.ActionButton>
                <Button x:Name="DownloadButton" Click="OnDownload" />
            </muxc:InfoBar.ActionButton>
        </muxc:InfoBar>

        <!-- Pick / drop files -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <Button x:Name="AddButton" Click="OnAdd" Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="ClearButton" Click="OnClear" />
        </StackPanel>

        <Border Grid.Row="3" CornerRadius="8" BorderThickness="1" Padding="4" MinHeight="120"
                AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <TextBlock x:Name="DropHint" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
                <ListView x:Name="FilesList" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ComboBox x:Name="FormatBox" MinWidth="220" Header="Convert to" />
            <Button x:Name="ConvertButton" Click="OnConvert" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
            <muxc:ProgressBar x:Name="Bar" Width="180" VerticalAlignment="Bottom" Margin="0,0,0,8" Value="0" Maximum="100" />
        </StackPanel>

        <StackPanel Grid.Row="5" Spacing="4">
            <TextBlock x:Name="Status" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="Results" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </StackPanel>
    </Grid>
</UserControl>
