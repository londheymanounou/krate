<UserControl
    x:Class="Krate.Gui.AudioTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Unloaded="OnUnloaded">

    <StackPanel Padding="24" Spacing="20" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="Subtitle" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" />

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LeftBtn" Grid.Column="0" Click="OnLeft" Height="130" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE767;" FontSize="30" />
                    <TextBlock x:Name="LeftLabel" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="RightBtn" Grid.Column="1" Click="OnRight" Height="130" HorizontalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE767;" FontSize="30" />
                    <TextBlock x:Name="RightLabel" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Button x:Name="BothBtn" Click="OnBoth" HorizontalAlignment="Center" MinWidth="180" />
        <TextBlock x:Name="Status" HorizontalAlignment="Center" Opacity="0.8" FontSize="16" Height="22" />
    </StackPanel>
</UserControl>
