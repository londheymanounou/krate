<UserControl
    x:Class="Krate.Gui.ColorSwatchesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="640" HorizontalAlignment="Center">
            <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
            <muxc:ColorPicker x:Name="Picker" ColorChanged="OnColorChanged"
                              IsAlphaEnabled="False" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" />
            <StackPanel x:Name="Rows" Spacing="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
