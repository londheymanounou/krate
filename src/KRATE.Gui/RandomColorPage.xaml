<UserControl
    x:Class="Krate.Gui.RandomColorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />

        <Button Click="OnCopy" Padding="0" BorderThickness="0" HorizontalAlignment="Center"
                Background="Transparent">
            <Border x:Name="Swatch" Width="300" Height="170" CornerRadius="12"
                    BorderThickness="1" BorderBrush="#33000000">
                <TextBlock x:Name="HexText" FontFamily="Consolas" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Button>

        <TextBlock x:Name="Details" FontFamily="Consolas" Opacity="0.8" HorizontalAlignment="Center" TextAlignment="Center" />

        <Button x:Name="RandomButton" Click="OnRandomize" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Center" MinWidth="160" />
    </StackPanel>
</UserControl>
