<UserControl
    x:Class="Krate.Gui.TimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />

        <TextBlock x:Name="Display" FontFamily="Consolas" FontSize="72" HorizontalAlignment="Center"
                   Text="00:00.0" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="StartButton" Click="OnStartStop" Style="{StaticResource AccentButtonStyle}" MinWidth="100" />
            <Button x:Name="ResetButton" Click="OnReset" MinWidth="100" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button x:Name="StopwatchButton" Click="OnStopwatch" />
            <Button x:Name="Pomodoro25" Click="OnPreset" Tag="25" />
            <Button x:Name="Pomodoro5" Click="OnPreset" Tag="5" />
            <Button x:Name="Preset10" Click="OnPreset" Tag="10" />
        </StackPanel>
    </StackPanel>
</UserControl>
