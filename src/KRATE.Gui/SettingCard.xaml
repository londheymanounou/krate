<UserControl
    x:Class="Krate.Gui.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PowerToys / Windows-Settings "SettingsCard": icon · header+description · right-aligned control.
         Hand-rolled so KRATE keeps its no-dependency promise. -->
    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="4" Padding="16,12" MinHeight="60">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon Grid.Column="0" FontFamily="Segoe Fluent Icons" FontSize="18" VerticalAlignment="Center"
                      Glyph="{x:Bind Glyph, Mode=OneWay}" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{x:Bind Header, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Opacity="0.6" FontSize="12"
                           TextWrapping="Wrap" Visibility="{x:Bind HasDescription, Mode=OneWay}" />
            </StackPanel>

            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Content="{x:Bind Action, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
