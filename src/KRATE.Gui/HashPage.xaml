<UserControl
    x:Class="Krate.Gui.HashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="HashRow" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Padding="20" Spacing="12" MaxWidth="820">
            <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

            <Border CornerRadius="8" BorderThickness="1" Height="140"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="12,6" Spacing="10">
                        <TextBlock x:Name="InputLabel" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                        <Button x:Name="PickFileBtn" Click="OnPickFile" Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="Pick File" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <TextBox x:Name="Input" BorderThickness="0" Background="Transparent" AcceptsReturn="True"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="14"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="OnChanged" />
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="MD5" VerticalAlignment="Center" />
                <TextBox x:Name="Md5" Grid.Row="0" Grid.Column="1" Style="{StaticResource HashRow}" />
                <Button x:Name="Md5Copy" Grid.Row="0" Grid.Column="2" Click="OnCopy" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="SHA-1" VerticalAlignment="Center" />
                <TextBox x:Name="Sha1" Grid.Row="1" Grid.Column="1" Style="{StaticResource HashRow}" />
                <Button x:Name="Sha1Copy" Grid.Row="1" Grid.Column="2" Click="OnCopy" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256" VerticalAlignment="Center" />
                <TextBox x:Name="Sha256" Grid.Row="2" Grid.Column="1" Style="{StaticResource HashRow}" />
                <Button x:Name="Sha256Copy" Grid.Row="2" Grid.Column="2" Click="OnCopy" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="SHA-512" VerticalAlignment="Center" />
                <TextBox x:Name="Sha512" Grid.Row="3" Grid.Column="1" Style="{StaticResource HashRow}" />
                <Button x:Name="Sha512Copy" Grid.Row="3" Grid.Column="2" Click="OnCopy" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
