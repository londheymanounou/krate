<UserControl
    x:Class="Krate.Gui.WheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded">

    <Grid Padding="24" ColumnSpacing="24" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Title" Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
            <TextBlock x:Name="EntriesLabel" Opacity="0.7" />
            <TextBox x:Name="Entries" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240"
                     VerticalAlignment="Stretch" TextChanged="OnEntriesChanged" FontFamily="Consolas" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="300" Height="300">
                <!-- Wheel; rotates on spin -->
                <Canvas x:Name="Wheel" Width="280" Height="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="Rot" CenterX="140" CenterY="140" />
                    </Canvas.RenderTransform>
                </Canvas>
                <!-- Fixed pointer at the top, pointing down into the wheel -->
                <Polygon Points="0,0 24,0 12,20" Fill="{ThemeResource SystemFillColorCriticalBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-2,0,0" />
            </Grid>

            <Button x:Name="SpinButton" Click="OnSpin" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" MinWidth="160" />
            <TextBlock x:Name="Winner" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
