<UserControl
    x:Class="Krate.Gui.YouTubePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="14" MaxWidth="560" HorizontalAlignment="Center">
            <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Subtitle" Opacity="0.75" TextWrapping="Wrap" />

            <InfoBar x:Name="SetupBar" IsOpen="False" IsClosable="False" Severity="Warning">
                <InfoBar.ActionButton>
                    <Button x:Name="SetupButton" Click="OnSetup" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="Url" TextMemberPath="Url" TextChanged="OnUrlChanged" SuggestionChosen="OnSuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,5">
                                <Image Source="{Binding Thumbnail}" Width="60" Height="45" Stretch="UniformToFill" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
                <ProgressRing x:Name="SearchRing" Grid.Column="1" Width="20" Height="20" Margin="10,0,0,0" Visibility="Collapsed" />
            </Grid>
            
            <Border x:Name="VideoInfoPanel" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="4" Width="160" Height="90" Margin="0,0,16,0">
                        <Image x:Name="Thumbnail" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="VideoTitle" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="VideoChannel" Opacity="0.75" />
                        <TextBlock x:Name="VideoDuration" FontFamily="Consolas" Opacity="0.6" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="FormatLabel" VerticalAlignment="Center" />
                <ComboBox x:Name="Format" MinWidth="110" />
                <Button x:Name="FolderButton" Click="OnChangeFolder" />
                <Button x:Name="DownloadButton" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>

            <TextBlock x:Name="FolderText" FontFamily="Consolas" Opacity="0.7" TextWrapping="Wrap" />

            <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" Opacity="0.85" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
