<UserControl
    x:Class="Krate.Gui.PasswordStrengthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <PasswordBox x:Name="Input" PasswordChanged="OnChanged" FontFamily="Consolas" FontSize="16" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Meter" Grid.Column="0" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center" />
            <TextBlock x:Name="Rating" Grid.Column="1" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="90" />
        </Grid>

        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Details" FontFamily="Consolas" FontSize="14" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
