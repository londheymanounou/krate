<UserControl
    x:Class="Krate.Gui.Games.SnakePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    KeyDown="OnKeyDown"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    IsTabStop="True">
    
    <Grid Padding="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <StackPanel>
                <TextBlock Text="Snake" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Use Arrow Keys or WASD to move." Opacity="0.7" />
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock x:Name="ScoreText" Text="Score: 0" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Restart" Click="OnRestart" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4">
            <Grid>
                <Canvas x:Name="GameCanvas" Width="400" Height="400" Background="Transparent" />
                
                <Border x:Name="GameOverOverlay" Background="#AA000000" CornerRadius="4" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                        <TextBlock Text="Game Over!" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                        <Button Content="Play Again" Click="OnRestart" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
