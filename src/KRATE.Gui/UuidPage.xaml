<UserControl
    x:Class="Krate.Gui.UuidPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <muxc:NumberBox x:Name="Count" Value="1" Minimum="1" Maximum="1000" SpinButtonPlacementMode="Compact" MinWidth="130" />
            <Button x:Name="GenerateButton" Click="OnGenerate" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" />
            <Button x:Name="CopyButton" Click="OnCopy" VerticalAlignment="Bottom" />
        </StackPanel>
        <TextBox x:Name="Result" IsReadOnly="True" AcceptsReturn="True" IsSpellCheckEnabled="False"
                 FontFamily="Consolas" FontSize="13" MinHeight="120" MaxHeight="320" />
    </StackPanel>
</UserControl>
