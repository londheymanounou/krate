<Window
    x:Class="Krate.Gui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnPaletteAccelerator" />
        </Grid.KeyboardAccelerators>

        <muxc:NavigationView x:Name="Nav"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="True"
                             SelectionChanged="OnToolSelected">
            <!-- Replaces PaneTitle="KRATE": the logo sits beside the wordmark, which is where a
                 Windows app puts its identity. The source is set in code-behind from the app folder
                 rather than ms-appx:// — this app is unpackaged, and a file path is unambiguous. -->
            <muxc:NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,0,2">
                    <Image x:Name="LogoImage" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Text="KRATE" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
            </muxc:NavigationView.PaneHeader>

            <muxc:NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="Search" QueryIcon="Find" TextChanged="OnSearchChanged" />
            </muxc:NavigationView.AutoSuggestBox>

            <!-- The content sits in a Fluent "card" surface, so the Mica shows around it like Settings. -->
            <Border Margin="0,4,16,16" CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Border>
        </muxc:NavigationView>

        <!-- Command palette (Ctrl+K): scrim + centred search box. -->
        <Grid x:Name="Palette" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}" Tapped="OnPaletteBackdrop">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnPaletteEscape" />
            </Grid.KeyboardAccelerators>
            <Border Width="540" MaxHeight="460" VerticalAlignment="Top" Margin="0,90,0,0"
                    CornerRadius="8" BorderThickness="1" Tapped="OnPaletteInner"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
                <Grid Padding="12" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="PaletteBox" Grid.Row="0" FontSize="16" TextChanged="OnPaletteQuery" />
                    <ListView x:Name="PaletteResults" Grid.Row="1" IsItemClickEnabled="True" ItemClick="OnPaletteInvoke"
                              SelectionMode="None" MaxHeight="380" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
