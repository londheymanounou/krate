<UserControl
    x:Class="Krate.Gui.SysInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <Border CornerRadius="8" Padding="16" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Info" FontFamily="Consolas" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </Border>

        <Button x:Name="RefreshButton" Click="OnRefresh" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
