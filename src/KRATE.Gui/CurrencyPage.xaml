<UserControl
    x:Class="Krate.Gui.CurrencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid ColumnSpacing="8" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <muxc:NumberBox x:Name="Amount" Grid.Column="0" Value="100" ValueChanged="OnChanged" />
            <ComboBox x:Name="From" Grid.Column="1" MinWidth="90" SelectionChanged="OnChanged" VerticalAlignment="Stretch" />
            <Button x:Name="SwapButton" Grid.Column="2" Click="OnSwap" VerticalAlignment="Stretch">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8AB;" FontSize="14" />
            </Button>
            <ComboBox x:Name="To" Grid.Column="3" MinWidth="90" SelectionChanged="OnChanged" VerticalAlignment="Stretch" />
        </Grid>

        <Border CornerRadius="8" Padding="20" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Result" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="Detail" Opacity="0.7" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
