<UserControl
    x:Class="Krate.Gui.RomanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="12" MaxWidth="440" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <TextBlock x:Name="ToRomanLabel" Opacity="0.7" />
        <muxc:NumberBox x:Name="Arabic" Value="2024" Minimum="1" Maximum="3999"
                        SpinButtonPlacementMode="Compact" ValueChanged="OnArabic" />
        <TextBlock x:Name="RomanOut" FontFamily="Consolas" FontSize="24" FontWeight="Bold" />

        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,8,0,8" />

        <TextBlock x:Name="ToArabicLabel" Opacity="0.7" />
        <TextBox x:Name="RomanIn" FontFamily="Consolas" TextChanged="OnRoman" />
        <TextBlock x:Name="ArabicOut" FontFamily="Consolas" FontSize="24" FontWeight="Bold" />
    </StackPanel>
</UserControl>
