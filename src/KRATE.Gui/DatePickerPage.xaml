<UserControl
    x:Class="Krate.Gui.DatePickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="520" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
        <CalendarDatePicker x:Name="Date" DateChanged="OnChanged" HorizontalAlignment="Stretch" />
        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Result" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
