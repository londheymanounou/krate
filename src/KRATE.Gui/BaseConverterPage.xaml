<UserControl
    x:Class="Krate.Gui.BaseConverterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="12" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="Subtitle" Opacity="0.7" TextWrapping="Wrap" />

        <TextBox x:Name="Hex" Header="Hexadecimal" FontFamily="Consolas" FontSize="16" TextChanged="OnChanged" />
        <TextBox x:Name="Dec" Header="Decimal" FontFamily="Consolas" FontSize="16" TextChanged="OnChanged" />
        <TextBox x:Name="Oct" Header="Octal" FontFamily="Consolas" FontSize="16" TextChanged="OnChanged" />
        <TextBox x:Name="Bin" Header="Binary" FontFamily="Consolas" FontSize="16" TextChanged="OnChanged" />

        <TextBlock x:Name="Error" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</UserControl>
