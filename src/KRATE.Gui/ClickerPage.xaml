<UserControl
    x:Class="Krate.Gui.ClickerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />

        <TextBlock x:Name="CountText" FontSize="96" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

        <Button x:Name="PlusButton" Click="OnPlus" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch" Height="72" FontSize="28" />

        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <Button x:Name="MinusButton" Click="OnMinus" MinWidth="120" />
            <Button x:Name="ResetButton" Click="OnReset" MinWidth="120" />
        </StackPanel>
    </StackPanel>
</UserControl>
