<UserControl
    x:Class="Krate.Gui.ColorTempPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />

        <Border x:Name="Swatch" Height="120" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="KelvinLabel" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
        </Border>

        <Slider x:Name="Kelvin" Minimum="1000" Maximum="12000" StepFrequency="100" Value="6500" ValueChanged="OnChanged" />

        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Values" FontFamily="Consolas" FontSize="14" IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
