<UserControl
    x:Class="Krate.Gui.ClockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded" Unloaded="OnUnloaded">

    <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />

        <Grid Width="240" Height="240" HorizontalAlignment="Center">
            <Ellipse Width="240" Height="240" StrokeThickness="2"
                     Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                     Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Canvas x:Name="Face" Width="240" Height="240">
                <Rectangle x:Name="HourHand" Width="6" Height="58" RadiusX="3" RadiusY="3"
                           Canvas.Left="117" Canvas.Top="62" Fill="{ThemeResource TextFillColorPrimaryBrush}">
                    <Rectangle.RenderTransform><RotateTransform x:Name="HourRot" CenterX="3" CenterY="58" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="MinuteHand" Width="4" Height="86" RadiusX="2" RadiusY="2"
                           Canvas.Left="118" Canvas.Top="34" Fill="{ThemeResource TextFillColorPrimaryBrush}">
                    <Rectangle.RenderTransform><RotateTransform x:Name="MinuteRot" CenterX="2" CenterY="86" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SecondHand" Width="2" Height="96" Canvas.Left="119" Canvas.Top="24" Fill="#E33">
                    <Rectangle.RenderTransform><RotateTransform x:Name="SecondRot" CenterX="1" CenterY="96" /></Rectangle.RenderTransform>
                </Rectangle>
                <Ellipse Width="12" Height="12" Canvas.Left="114" Canvas.Top="114" Fill="#E33" />
            </Canvas>
        </Grid>

        <TextBlock x:Name="Digital" FontFamily="Consolas" FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="DateText" Opacity="0.75" FontSize="15" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
