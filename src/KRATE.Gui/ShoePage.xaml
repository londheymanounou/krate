<UserControl
    x:Class="Krate.Gui.ShoePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <StackPanel Padding="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Center">
        <TextBlock x:Name="Title" Style="{StaticResource TitleTextBlockStyle}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <muxc:NumberBox x:Name="Size" Value="42" SmallChange="0.5" SpinButtonPlacementMode="Compact" MinWidth="140" ValueChanged="OnChanged" />
            <ComboBox x:Name="System" SelectionChanged="OnChanged" MinWidth="120" VerticalAlignment="Bottom" />
            <ComboBox x:Name="Gender" SelectionChanged="OnChanged" MinWidth="120" VerticalAlignment="Bottom" />
        </StackPanel>
        <Border CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <TextBlock x:Name="Result" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
        </Border>
    </StackPanel>
</UserControl>
